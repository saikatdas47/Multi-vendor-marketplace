# ============================================================================
#  CommerceX — environment configuration
#  Never commit this file. Copy .env.example instead.
# ============================================================================

# ---------------------------------------------------------------- core
DEBUG=True
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Dhaka
LOG_LEVEL=INFO

# ------------------------------------------------------------ database
# Hosted platforms (Neon, Render, Railway, Supabase) hand out ONE connection
# string. Set it and the five DB_* variables below are ignored entirely.
# Keep any ?sslmode=require on the end — Neon refuses connections without it.
DATABASE_URL=

DB_NAME=commercex
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ----------------------------------------------------------------- jwt
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
JWT_ROTATE_REFRESH=True
JWT_BLACKLIST_AFTER_ROTATION=True

# ------------------------------------------------------- cors / origins
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------------------------- email
# Blank EMAIL_HOST_USER => emails print to the console (no SMTP needed).
# Gmail requires an App Password, not your account password:
#   myaccount.google.com > Security > 2-Step Verification > App passwords
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=

# ------------------------------------------------------ email tokens
VERIFY_TOKEN_TTL_HOURS=48
RESET_TOKEN_TTL_HOURS=1

# ------------------------------------------------------------------ ai
# Blank GROQ_API_KEY => AI features degrade gracefully (503 / 204).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=20
GROQ_MAX_TOKENS=400
# low | medium | high — leave blank unless the model supports it
GROQ_REASONING_EFFORT=
# Per-feature token ceilings. Lower = cheaper.
AI_DESCRIPTION_MAX_TOKENS=260
AI_SUMMARY_MAX_TOKENS=180
# Cost control: how much review text is sent to the model.
AI_SUMMARY_MAX_REVIEWS=25
AI_SUMMARY_COMMENT_CHARS=180
# How long AI answers are reused instead of re-billed (seconds).
AI_DESCRIPTION_CACHE_TTL=86400
AI_SUMMARY_CACHE_TTL=21600
# Shopping assistant
ASSISTANT_MAX_TOKENS=320
ASSISTANT_HISTORY_TURNS=4
ASSISTANT_CANDIDATES=8


# --------------------------------------------------------- rate limits
THROTTLE_ANON=100/hour
THROTTLE_USER=1000/hour
THROTTLE_EMAIL=5/hour
THROTTLE_AI=20/hour

# ------------------------------------------------------------ api / files
PAGE_SIZE=20
MAX_PAGE_SIZE=100
MAX_UPLOAD_MB=10

# ---------------------------------------------------------- marketplace
DEFAULT_COMMISSION_RATE=10.00
# Flat monthly fee each approved shop is invoiced.
PLATFORM_MONTHLY_FEE=29.00
DEFAULT_COUNTRY=Bangladesh
CURRENCY=USD

# --------------------------------------------------- optional overrides
# These all have working defaults; listed here so nothing is hidden in code.
LANGUAGE_CODE=en-us
PASSWORD_MIN_LENGTH=8

API_TITLE=CommerceX API
API_VERSION=1.0.0

STATIC_URL=static/
STATIC_DIR=staticfiles
MEDIA_URL=media/
MEDIA_DIR=media

EMAIL_USE_SSL=False
CORS_ALLOW_CREDENTIALS=True

CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=commercex-cache
CACHE_TIMEOUT=300

# Applied only when DEBUG=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
