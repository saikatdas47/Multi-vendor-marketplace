# ============================================================================
#  CommerceX frontend — Vite environment
#  Only VITE_* variables are exposed to the browser. Never put secrets here:
#  anything in this file ships in the JS bundle and is readable by any visitor.
# ============================================================================

# Dev server port
VITE_PORT=5173

# Where the Django API lives. Used by the dev-server proxy.
VITE_API_TARGET=http://127.0.0.1:8000

# Leave blank to route through the dev proxy (avoids CORS entirely).
# Set to an absolute URL when the API is on another host in production.
VITE_API_BASE_URL=

# Request timeout in milliseconds
VITE_API_TIMEOUT=20000

# Display
VITE_APP_NAME=CommerceX
VITE_CURRENCY=USD
VITE_DEFAULT_COUNTRY=Bangladesh
