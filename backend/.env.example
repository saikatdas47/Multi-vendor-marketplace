# CommerceX Node.js / Express configuration
# Copy this file to .env and supply your own secrets. Never commit .env.

NODE_ENV=development
DEBUG=true
PORT=8000

# Neon pooled PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/database?sslmode=require
DATABASE_SSL=true

# Optional locally; the API falls back to PostgreSQL when Redis is unavailable.
REDIS_URL=redis://localhost:6379

# Generate a long random value. Do not reuse the former Django SECRET_KEY.
JWT_SECRET=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
PASSWORD_MIN_LENGTH=8

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudinary uploads
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
MAX_UPLOAD_MB=10

# SMTP is disabled when username or password is blank.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
VERIFY_TOKEN_TTL_HOURS=48
RESET_TOKEN_TTL_HOURS=1

# Grounded shopping assistant; blank key keeps the catalogue fallback active.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=20000
ASSISTANT_MAX_TOKENS=320
ASSISTANT_CANDIDATES=8

PAGE_SIZE=20
DEFAULT_COMMISSION_RATE=10.00
PLATFORM_MONTHLY_FEE=29.00
DEFAULT_COUNTRY=Bangladesh

API_TITLE=CommerceX API
API_VERSION=1.0.0

# Integration tests and benchmarks
BASE_URL=http://localhost:8000
DEMO_PASSWORD=change-me-for-your-own-seed
